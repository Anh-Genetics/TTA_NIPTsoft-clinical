{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NIPT Clinical Report Schema",
  "description": "Schema for machine-readable NIPT clinical report output",
  "type": "object",
  "required": [
    "schema_version", "pipeline_version", "genome_build", "clinical_tier",
    "sample_id", "run_id", "report_generated",
    "qc_summary", "results", "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Report schema version"
    },
    "pipeline_version": {
      "type": "string",
      "description": "Pipeline version that generated this report"
    },
    "genome_build": {
      "type": "string",
      "description": "Reference genome build used",
      "enum": ["hg19", "GRCh37", "hg38", "GRCh38"]
    },
    "clinical_tier": {
      "type": "string",
      "description": "Clinical analysis tier",
      "enum": ["tier1", "tier2"]
    },
    "config_version": {
      "type": "string",
      "description": "Clinical configuration version"
    },
    "sample_id": {
      "type": "string",
      "description": "Sample identifier"
    },
    "run_id": {
      "type": "string",
      "description": "Sequencing run identifier"
    },
    "report_generated": {
      "type": "string",
      "description": "ISO 8601 timestamp of report generation",
      "format": "date-time"
    },
    "qc_summary": {
      "type": "object",
      "required": ["status", "reportable"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "reportable": {
          "type": "boolean",
          "description": "Whether results can be reported (all QC gates passed)"
        },
        "fetal_fraction": {
          "type": ["number", "null"],
          "description": "Estimated fetal fraction (0-1 scale)"
        },
        "mapping_rate": {
          "type": ["number", "null"],
          "description": "Unique mapping rate (0-1 scale)"
        },
        "raw_reads": {
          "type": ["integer", "null"],
          "description": "Total raw reads"
        },
        "mapped_reads": {
          "type": ["integer", "null"],
          "description": "Uniquely mapped reads"
        },
        "dup_rate": {
          "type": ["number", "null"],
          "description": "Duplication rate (0-1 scale)"
        },
        "no_call_reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of QC gate failure codes"
        },
        "failed_gates": {
          "type": "array",
          "description": "Detailed list of failed QC gates"
        }
      }
    },
    "results": {
      "type": "object",
      "description": "Per-target clinical results",
      "additionalProperties": {
        "type": "object",
        "required": ["chromosome", "classification", "clinical_risk"],
        "properties": {
          "chromosome": {
            "type": "string",
            "description": "Chromosome identifier"
          },
          "classification": {
            "type": "string",
            "description": "Internal classification code",
            "enum": [
              "HIGH_RISK", "LOW_RISK", "GREY_ZONE",
              "NO_CALL", "SUSPECTED_RAA", "INSUFFICIENT_EVIDENCE"
            ]
          },
          "clinical_risk": {
            "type": "string",
            "description": "Human-readable clinical risk category",
            "enum": [
              "HIGH RISK", "LOW RISK", "BORDERLINE",
              "NO CALL", "SUSPECTED RAA", "INSUFFICIENT EVIDENCE"
            ]
          },
          "z_score": {
            "type": ["number", "null"],
            "description": "Robust Z-score"
          },
          "no_call_reasons": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Specific no-call reasons for this target"
          }
        }
      }
    },
    "inferred_sex": {
      "type": ["string", "null"],
      "enum": ["male", "female", null],
      "description": "Inferred fetal sex from chromosome representation"
    },
    "reported_sex": {
      "type": ["string", "null"],
      "description": "Clinically reported fetal sex"
    },
    "disclaimer": {
      "type": "string",
      "description": "Mandatory clinical disclaimer text",
      "minLength": 50
    }
  },
  "additionalProperties": true
}
