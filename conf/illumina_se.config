// ============================================================
// conf/illumina_se.config — Illumina single-end specific settings
// ============================================================

params {

    // ── Read characteristics ───────────────────────────────────
    read_length       = 75          // expected read length (35-75 bp common for NIPT)
    min_read_length   = 30          // fastp min length filter
    max_read_length   = 0           // 0 = no max
    quality_threshold = 20          // phred Q threshold for quality trimming

    // ── Adapter sequences (Illumina universal) ────────────────
    adapter_sequence  = 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA'

    // ── fastp settings ────────────────────────────────────────
    fastp_low_complexity_filter    = true
    fastp_complexity_threshold     = 30
    fastp_disable_length_filtering = false
    fastp_n_base_limit             = 5
    fastp_average_qual             = 20

    // ── Alignment settings ────────────────────────────────────
    bowtie2_mode      = '--very-sensitive'
    bowtie2_no_unal   = true        // suppress unaligned reads in output
    mapq_threshold    = 30          // post-alignment MAPQ filter

    // ── Deduplication ─────────────────────────────────────────
    // NOTE: cfDNA deduplication is controversial; default OFF.
    // Enable only if library protocol includes UMIs or per SOP.
    mark_duplicates   = true
    remove_duplicates = false       // mark but do not remove

    // ── Bin size ──────────────────────────────────────────────
    bin_size_kb       = 50          // 50 kb bins

}
