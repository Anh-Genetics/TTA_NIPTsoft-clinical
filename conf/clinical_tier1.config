// ============================================================
// conf/clinical_tier1.config — T21/T18/T13 mandatory screening
// ============================================================

params {

    clinical_tier         = 'tier1'
    enable_raa            = false
    enable_microdeletion  = false

    // ── QC thresholds (validated, DO NOT change without CCR) ──
    min_raw_reads         = 10000000   // 10M reads minimum
    min_unique_reads      = 5000000    // 5M unique mapped reads
    max_dup_rate          = 0.30       // 30% duplication max
    min_fetal_fraction    = 0.04       // 4% FF minimum
    min_mapping_rate      = 0.75       // 75% unique mapping rate
    mapq_threshold        = 30

    // ── Statistical calling thresholds ────────────────────────
    zscore_high_risk      = 3.0        // Z >= 3.0 => High risk
    zscore_grey_zone_lo   = 2.5        // 2.5 <= Z < 3.0 => borderline
    zscore_low_risk       = 2.5        // Z < 2.5 => Low risk

    // ── NCV thresholds (if NCV model used) ────────────────────
    ncv_high_risk         = 3.0
    ncv_low_risk          = 2.5

    // ── Targets ───────────────────────────────────────────────
    autosomal_targets     = ['chr21', 'chr18', 'chr13']
    sex_chr_targets       = ['chrX', 'chrY']

    // ── Reporting ─────────────────────────────────────────────
    report_clinical_disclaimer = true
    report_include_qc_details  = true

    // ── Audit ─────────────────────────────────────────────────
    config_version        = '1.0.0'
    config_locked         = true       // flag for audit trail

}
