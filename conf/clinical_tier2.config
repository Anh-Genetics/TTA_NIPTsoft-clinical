// ============================================================
// conf/clinical_tier2.config — Extended screening (SCAs, RAA, microdeletion)
// IMPORTANT: Tier2 modules have lower analytical sensitivity.
// These results are supplementary and require additional validation
// before clinical deployment. Conservative no-call thresholds are enforced.
// ============================================================

params {

    clinical_tier         = 'tier2'
    enable_raa            = true
    enable_microdeletion  = true

    // ── Tier1 thresholds (inherited) ──────────────────────────
    min_raw_reads         = 12000000   // stricter for tier2
    min_unique_reads      = 6000000
    max_dup_rate          = 0.25
    min_fetal_fraction    = 0.04
    min_mapping_rate      = 0.75
    mapq_threshold        = 30

    // ── T21/T18/T13 calling ───────────────────────────────────
    zscore_high_risk      = 3.0
    zscore_grey_zone_lo   = 2.5
    zscore_low_risk       = 2.5

    // ── SCA calling (separate model, chrX/chrY) ───────────────
    sca_zscore_threshold  = 3.0
    sca_min_ff_xy         = 0.04      // minimum FF for SCA calls
    sex_chr_targets       = ['chrX', 'chrY']

    // ── RAA scan (autosome-wide, strict thresholds) ───────────
    raa_zscore_threshold  = 4.0       // stricter than autosomal aneuploidies
    raa_min_size_bins     = 5         // minimum consecutive bins
    raa_min_ff            = 0.06      // stricter FF requirement for RAA
    raa_chromosomes       = [         // autosomes to scan (exclude T21/T18/T13)
        'chr1', 'chr2', 'chr3', 'chr4', 'chr5', 'chr6', 'chr7', 'chr8',
        'chr9', 'chr10', 'chr11', 'chr12', 'chr14', 'chr15', 'chr16',
        'chr17', 'chr19', 'chr20', 'chr22'
    ]

    // ── Microdeletion panel (curated, strictest) ──────────────
    microdeletion_zscore  = 5.0       // very strict threshold
    microdeletion_min_ff  = 0.08      // 8% FF minimum for microdeletion
    microdeletion_min_bins = 2        // minimum bins overlapping region
    // Microdeletion regions are defined in assets/panel/microdeletion_panel.bed
    // Panel includes: DiGeorge (22q11.2), 1p36, Wolf-Hirschhorn (4p16.3),
    //                 Cri-du-chat (5p15.2), Prader-Willi/Angelman (15q11-q13),
    //                 and others per lab validation.

    // ── Reporting ─────────────────────────────────────────────
    report_clinical_disclaimer = true
    report_include_qc_details  = true
    report_include_raa         = true
    report_include_microdeletion = true

    // ── Audit ─────────────────────────────────────────────────
    config_version        = '1.0.0'
    config_locked         = true

}
