// ============================================================
// conf/base.config — resource defaults for all processes
// ============================================================

process {

    // ── Default resources ─────────────────────────────────────
    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    time   = { check_max( 2.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ── Per-process overrides ──────────────────────────────────

    withName: 'VALIDATE_SAMPLESHEET' {
        cpus   = 1
        memory = '1.GB'
        time   = '10.min'
    }

    withName: 'FASTP_QC' {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }

    withName: 'BOWTIE2_ALIGN' {
        cpus   = { check_max( 8 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 6.h * task.attempt, 'time' ) }
    }

    withName: 'BAM_FILTER' {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }

    withName: 'BIN_COUNT' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }
    }

    withName: 'GC_CORRECT' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }
    }

    withName: 'FF_ESTIMATE' {
        cpus   = 1
        memory = '4.GB'
        time   = '30.min'
    }

    withName: 'ANEUPLOIDY_CALL|SCA_CALL|RAA_SCAN|MICRODELETION_CALL' {
        cpus   = 1
        memory = '4.GB'
        time   = '30.min'
    }

    withName: 'QC_GATE' {
        cpus   = 1
        memory = '2.GB'
        time   = '15.min'
    }

    withName: 'MAKE_REPORT' {
        cpus   = 1
        memory = '4.GB'
        time   = '30.min'
    }

}

// ── Max resource helper ───────────────────────────────────────
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) { return obj }
    }
}

// ── Max resource params (override per executor) ───────────────
params {
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '48.h'
}
