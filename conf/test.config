// ============================================================
// conf/test.config — minimal test profile with mock data
// ============================================================

params {
    samplesheet           = "${projectDir}/tests/data/samplesheet_test.csv"
    clinical_tier         = 'tier1'
    outdir                = 'test_results'

    // Point to mock/stub assets
    bowtie2_index         = "${projectDir}/tests/data/mock_genome/mock_idx"
    blacklist_bed         = "${projectDir}/tests/data/mock_genome/blacklist.bed"
    bins_bed              = "${projectDir}/tests/data/mock_genome/bins.bed"
    gc_content_bed        = "${projectDir}/tests/data/mock_genome/gc.bed"
    mappability_bed       = "${projectDir}/tests/data/mock_genome/mappability.bed"
    euploid_reference     = "${projectDir}/tests/data/mock_controls/euploid_ref.parquet"
    microdeletion_panel_bed = "${projectDir}/tests/data/mock_controls/microdeletion.bed"

    // Relaxed QC for test/mock data
    min_raw_reads         = 1000
    min_unique_reads      = 500
    max_dup_rate          = 0.80
    min_fetal_fraction    = 0.01
    min_mapping_rate      = 0.20
}

process {
    withName: 'BOWTIE2_ALIGN' {
        cpus   = 2
        memory = '4.GB'
        time   = '30.min'
    }
}
