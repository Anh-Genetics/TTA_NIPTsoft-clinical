// ============================================================
// TTA_NIPTsoft-clinical — Nextflow main configuration
// ============================================================

manifest {
    name            = 'TTA_NIPTsoft-clinical'
    description     = 'Clinical-grade NIPT analysis pipeline for Illumina SE data'
    version         = '1.0.0'
    author          = 'Anh-Genetics'
    homePage        = 'https://github.com/Anh-Genetics/TTA_NIPTsoft-clinical'
    nextflowVersion = '>=23.04.0'
    defaultBranch   = 'main'
}

// ── Global parameters (override via --param_name) ────────────
params {

    // ── Identity ─────────────────────────────────────────────
    pipeline_version      = '1.0.0'
    pipeline_name         = 'TTA_NIPTsoft-clinical'
    genome_build          = 'hg19'

    // ── Input ─────────────────────────────────────────────────
    samplesheet           = null
    run_id                = "RUN_${new java.text.SimpleDateFormat('yyyyMMdd').format(new Date())}"

    // ── Clinical tier ─────────────────────────────────────────
    // tier1 = T21/T18/T13 only
    // tier2 = tier1 + SCA + RAA + microdeletion
    clinical_tier         = 'tier1'
    enable_raa            = false
    enable_microdeletion  = false

    // ── Reference genome ──────────────────────────────────────
    bowtie2_index         = 'assets/genome/hg19/hg19'
    blacklist_bed         = 'assets/genome/hg19_blacklist.bed'
    bins_bed              = 'assets/genome/hg19_50kb_bins.bed'
    gc_content_bed        = 'assets/genome/hg19_50kb_gc.bed'
    mappability_bed       = 'assets/genome/hg19_50kb_mappability.bed'

    // ── Reference data ────────────────────────────────────────
    euploid_reference     = 'assets/controls/euploid_reference_matrix.parquet'
    microdeletion_panel_bed = 'assets/panel/microdeletion_panel.bed'

    // ── QC thresholds (validated operating points) ────────────
    min_raw_reads         = 8000000
    min_unique_reads      = 4000000
    max_dup_rate          = 0.35
    min_fetal_fraction    = 0.04
    min_mapping_rate      = 0.70
    mapq_threshold        = 30

    // ── Statistical thresholds ────────────────────────────────
    // Aneuploidy calling
    zscore_high_risk      = 3.0
    zscore_low_risk       = 2.5
    // SCA calling (separate model)
    sca_zscore_threshold  = 3.0
    // RAA calling (stricter)
    raa_zscore_threshold  = 4.0
    raa_min_size_bins     = 5
    // Microdeletion (strictest)
    microdeletion_zscore  = 5.0
    microdeletion_min_ff  = 0.08

    // ── Output ────────────────────────────────────────────────
    outdir                = 'results'
    publish_bam           = false
    tracedir              = "${params.outdir}/pipeline_info"

}

// ── Include config files ──────────────────────────────────────
includeConfig 'conf/base.config'

// ── Profiles ─────────────────────────────────────────────────
profiles {

    illumina_se {
        includeConfig 'conf/illumina_se.config'
    }

    clinical_tier1 {
        includeConfig 'conf/clinical_tier1.config'
    }

    clinical_tier2 {
        includeConfig 'conf/clinical_tier2.config'
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    test {
        includeConfig 'conf/test.config'
    }

}

// ── Timeline / trace / report ────────────────────────────────
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.tracedir}/execution_trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,status,exit,submit,start,complete,duration,realtime,cpus,memory'
}
dag {
    enabled   = true
    file      = "${params.tracedir}/pipeline_dag.html"
    overwrite = true
}

// ── Default container / conda fallback ───────────────────────
process.container = 'ghcr.io/anh-genetics/nipt-clinical:1.0.0'
